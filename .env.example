# MODELO DE CONFIGURAÇÃO - CLOUDAUDIO
# Renomeie este arquivo para .env e preencha com suas chaves reais.

# SUPABASE
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_publica_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_chave_privada_admin_aqui

# SERVER
PORT=3000
FRONTEND_URL=http://localhost:4200

# -----------------------------------------------------------------------------
# YOUTUBE (opcional) - usado em /api/youtube/convert
# -----------------------------------------------------------------------------
# O erro "Sign in to confirm you're not a bot" é um bloqueio do próprio YouTube,
# geralmente por reputação do IP/datacenter. Para melhorar a taxa de sucesso,
# use cookies de uma sessão logada (formato exportado por extensões como EditThisCookie).
#
# SEGURANÇA: se você já expôs cookies/proxy em logs, prints ou no Git, considere-os
# COMPROMETIDOS e ROTACIONE/regenere os cookies imediatamente.
# Nunca comite cookies no Git.
#
# `YOUTUBE_COOKIE` aceita:
#  - JSON array exportado do navegador (obj com {name,value})
#  - Cookie header (ex.: "SID=...; HSID=...; ...")
#  - Base64 que decodifica para um dos formatos acima
YOUTUBE_COOKIE=
# Proxy (recomendado residencial/ISP estável; IP de datacenter barato costuma ser bloqueado)
# Formato: http://usuario:senha@host:porta
YOUTUBE_PROXY_URL=

# -----------------------------------------------------------------------------
# YT-DLP FALLBACK (opcional) - usado quando o YouTube bloqueia o ytdl-core
# -----------------------------------------------------------------------------
# Quando `ENABLE_YTDLP_FALLBACK=true`, o backend tenta usar yt-dlp como fallback.
# Se quiser exigir o binário no startup, use `ENABLE_YTDLP_FALLBACK=required`.
ENABLE_YTDLP_FALLBACK=true
# Caminho/command do yt-dlp no servidor (ex.: `yt-dlp` no PATH, `.bin/yt-dlp`, `/opt/render/project/src/.bin/yt-dlp`)
YTDLP_PATH=/opt/render/project/src/.bin/yt-dlp

# -----------------------------------------------------------------------------
# YOUTUBE PO TOKEN (recomendado em produção/cloud)
# -----------------------------------------------------------------------------
# O "Sign in to confirm you're not a bot" em IPs de datacenter (Render, Vercel, etc)
# raramente é resolvido só com cookies — o YouTube agora exige um PO Token (Proof of
# Origin) gerado por um navegador real. Sem PO Token, o yt-dlp falha em quase todos
# os clients quando rodando na nuvem.
#
# Como gerar:
#  1) Local (uma vez):  yt-dlp --extractor-args "youtube:player_client=mweb" -F <url>
#     Use o plugin oficial bgutil-pot-http (https://github.com/Brainicism/bgutil-ytdlp-pot-provider)
#     ou a extensão YouTubeJS para extrair o token.
#  2) Cole o token aqui. Ele dura semanas/meses para o mesmo visitor_data.
#
# Quando configurado, o backend prioriza clients mweb/web (que usam PO Token) e
# tem taxa de sucesso muito maior em IPs de datacenter.
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=

# -----------------------------------------------------------------------------
# INSTÂNCIAS DE FALLBACK (opcional)
# -----------------------------------------------------------------------------
# Por padrão usamos uma lista curta de instâncias confirmadamente vivas. Se quiser
# adicionar/substituir, passe lista separada por vírgula (ou espaço).
COBALT_INSTANCES=
# Se a instância Cobalt exigir auth, configure UMA das duas:
COBALT_API_KEY=
COBALT_BEARER_TOKEN=

PIPED_INSTANCES=
INVIDIOUS_INSTANCES=
