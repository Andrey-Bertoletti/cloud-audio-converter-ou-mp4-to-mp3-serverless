# MODELO DE CONFIGURAÇÃO - CLOUDAUDIO
# Renomeie este arquivo para .env e preencha com suas chaves reais.

# SUPABASE
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_publica_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_chave_privada_admin_aqui

# SERVER
PORT=3000
FRONTEND_URL=http://localhost:4200

# -----------------------------------------------------------------------------
# YOUTUBE (opcional) - usado em /api/youtube/convert
# -----------------------------------------------------------------------------
# O erro "Sign in to confirm you're not a bot" é um bloqueio do próprio YouTube,
# geralmente por reputação do IP/datacenter. Para melhorar a taxa de sucesso,
# use cookies de uma sessão logada (formato exportado pelo EditThisCookie).
# Nunca comite cookies no Git.
#
# Formato 1 (recomendado): JSON (array) com cookies exportados
YOUTUBE_COOKIE=[]
# Formato 2: JSON em base64 (útil quando o provedor não aceita JSON direto)
YOUTUBE_COOKIE_BASE64=
# Formato 3: header "Cookie:" bruto (ex.: "SID=...; HSID=...; ...")
YOUTUBE_COOKIE_HEADER=
# Proxy opcional (se necessário para restrição regional)
YOUTUBE_PROXY_URI=
